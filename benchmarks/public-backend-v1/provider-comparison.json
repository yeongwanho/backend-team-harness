            "reports": [
              "coverage/bth-junit.xml"
            ],
            "cases": [
              {
                "className": "test/bth/session-hash.spec.ts",
                "name": "service delegates both current ID and hash with the replacement hash"
              },
              {
                "className": "test/bth/session-hash.spec.ts",
                "name": "relational rotation includes ID and old hash in the update predicate"
              },
              {
                "className": "test/bth/session-hash.spec.ts",
                "name": "relational no-match returns null without reading an unrelated session"
              },
              {
                "className": "test/bth/session-hash.spec.ts",
                "name": "relational deletion after update remains null"
              },
              {
                "className": "test/bth/session-hash.spec.ts",
                "name": "relational update errors propagate without a read"
              },
              {
                "className": "test/bth/session-hash.spec.ts",
                "name": "document rotation uses a conditional predicate and requests the updated document"
              },
              {
                "className": "test/bth/session-hash.spec.ts",
                "name": "document no-match remains null and persistence errors propagate"
              },
              {
                "className": "test/bth/session-hash.spec.ts",
                "name": "auth signs only after conditional rotation and embeds the rotated hash"
              },
              {
                "className": "test/bth/session-hash.spec.ts",
                "name": "a failed conditional match cannot issue tokens despite plausible prior session state"
              },
              {
                "className": "test/bth/session-hash.spec.ts",
                "name": "an absent session is rejected without issuing tokens"
              },
              {
                "className": "test/bth/session-hash.spec.ts",
                "name": "auth waits for conditional persistence before signing"
              },
              {
                "className": "test/bth/session-hash.spec.ts",
                "name": "conditional persistence errors and a missing user do not produce tokens"
              }
            ]
          }
        },
