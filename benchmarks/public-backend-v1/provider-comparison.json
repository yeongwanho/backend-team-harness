{
  "schemaVersion": 1,
  "corpusId": "public-backend-v1",
  "repositories": [
    {
      "id": "spring-petclinic",
      "buildSystem": "maven",
      "allowedPrefixes": ["src/"],
      "setupCommand": ["./mvnw", "-q", "-DskipTests=false", "verify"],
      "tasks": [
        {
          "id": "spring-01-pet-association",
          "decisions": { "modules": ["root"], "databaseImpact": "write", "apiImpact": "compatible" },
          "acceptance": {
            "kind": "target-tests",
            "testPaths": ["src/test/java/org/springframework/samples/petclinic/owner/OwnerTests.java", "src/test/java/org/springframework/samples/petclinic/owner/PetValidatorTests.java"],
            "command": ["./mvnw", "-q", "-o", "-Dtest=OwnerTests,PetValidatorTests", "test"],
            "reports": ["target/surefire-reports/TEST-org.springframework.samples.petclinic.owner.OwnerTests.xml", "target/surefire-reports/TEST-org.springframework.samples.petclinic.owner.PetValidatorTests.xml"],
            "cases": [
              { "className": "org.springframework.samples.petclinic.owner.OwnerTests", "name": "addPetAddsPersistedPet" },
              { "className": "org.springframework.samples.petclinic.owner.OwnerTests", "name": "addPetDoesNotAddDuplicatePet" },
              { "className": "org.springframework.samples.petclinic.owner.PetValidatorTests", "name": "validate" },
              { "className": "org.springframework.samples.petclinic.owner.PetValidatorTests$ValidateHasErrors", "name": "validateWithLongPetName" }
            ]
          }
        },
        {
          "id": "spring-02-owner-search-whitespace",
          "decisions": { "modules": ["root"], "databaseImpact": "read", "apiImpact": "compatible" },
          "acceptance": {
            "kind": "target-tests",
            "testPaths": ["src/test/java/org/springframework/samples/petclinic/owner/OwnerControllerTests.java"],
            "command": ["./mvnw", "-q", "-o", "-Dtest=OwnerControllerTests#processFindFormIgnoresSurroundingWhitespace+processFindFormWithWhitespaceOnlyLastNameReturnsAllOwners", "test"],
            "reports": ["target/surefire-reports/TEST-org.springframework.samples.petclinic.owner.OwnerControllerTests.xml"],
            "cases": [
              { "className": "org.springframework.samples.petclinic.owner.OwnerControllerTests", "name": "processFindFormIgnoresSurroundingWhitespace" },
              { "className": "org.springframework.samples.petclinic.owner.OwnerControllerTests", "name": "processFindFormWithWhitespaceOnlyLastNameReturnsAllOwners" }
            ]
          }
        },
        { "id": "spring-03-unique-pet-name", "decisions": { "modules": ["root"], "databaseImpact": "schema", "schemaStrategy": "bootstrap-only", "apiImpact": "compatible" } },
        {
          "id": "spring-04-future-visit",
          "decisions": { "modules": ["root"], "databaseImpact": "none", "apiImpact": "compatible" },
          "acceptance": {
            "kind": "fixture-tests",
            "files": [{ "path": "src/test/java/org/springframework/samples/petclinic/owner/VisitAcceptanceTests.java", "fixture": "fixtures/spring/VisitAcceptanceTests.java", "sha256": "05ab5e569fd6462a063bae452ba60678e70b466fe973506526e23fdf88924dcf" }],
            "command": ["./mvnw", "-q", "-o", "-Dtest=VisitAcceptanceTests", "test"],
            "reports": ["target/surefire-reports/TEST-org.springframework.samples.petclinic.owner.VisitAcceptanceTests.xml"],
            "cases": [
              { "className": "org.springframework.samples.petclinic.owner.VisitAcceptanceTests", "name": "rejectsTodayAndPastWithLocalizedDateError" },
              { "className": "org.springframework.samples.petclinic.owner.VisitAcceptanceTests", "name": "acceptsTomorrowAndLater" },
              { "className": "org.springframework.samples.petclinic.owner.VisitAcceptanceTests", "name": "defaultsNewVisitToTomorrow" },
              { "className": "org.springframework.samples.petclinic.owner.VisitAcceptanceTests", "name": "rendersTomorrowAsMinimumDate" },
              { "className": "org.springframework.samples.petclinic.owner.VisitAcceptanceTests", "name": "declaresLocalizedVisitDateMessages" },
              { "className": "org.springframework.samples.petclinic.owner.VisitAcceptanceTests", "name": "keepsDescriptionRequired" }
            ]
          }
        },
        {
          "id": "spring-05-binder-id-protection",
          "decisions": { "modules": ["root"], "databaseImpact": "none", "apiImpact": "compatible" },
          "acceptance": {
            "kind": "fixture-tests",
            "files": [{ "path": "src/test/java/org/springframework/samples/petclinic/owner/BinderAcceptanceTests.java", "fixture": "fixtures/spring/BinderAcceptanceTests.java", "sha256": "00654a24c40c52f55626c1c8465f253575fcc8122af61291282aaa654d434f86" }],
            "command": ["./mvnw", "-q", "-o", "-Dtest=BinderAcceptanceTests", "test"],
            "reports": ["target/surefire-reports/TEST-org.springframework.samples.petclinic.owner.BinderAcceptanceTests.xml"],
            "cases": [
              { "className": "org.springframework.samples.petclinic.owner.BinderAcceptanceTests", "name": "ownerRequestRejectsDirectAndNestedIdsButBindsMutableFields" },
              { "className": "org.springframework.samples.petclinic.owner.BinderAcceptanceTests", "name": "petRequestRejectsDirectAndNestedIdsButBindsMutableFields" },
              { "className": "org.springframework.samples.petclinic.owner.BinderAcceptanceTests", "name": "visitRequestRejectsDirectAndNestedIdsButBindsDescription" },
              { "className": "org.springframework.samples.petclinic.owner.BinderAcceptanceTests", "name": "petNameValidationRemainsActive" },
              { "className": "org.springframework.samples.petclinic.owner.BinderAcceptanceTests", "name": "petTypeValidationRemainsActive" }
            ]
          }
        },
        {
          "id": "spring-06-pet-update",
          "decisions": { "modules": ["root"], "databaseImpact": "write", "apiImpact": "compatible" },
          "acceptance": {
            "kind": "fixture-tests",
            "files": [{ "path": "src/test/java/org/springframework/samples/petclinic/owner/PetUpdateAcceptanceTests.java", "fixture": "fixtures/spring/PetUpdateAcceptanceTests.java", "sha256": "bf4c3a3052701b8c5f98e817aeed01b6799a21a82a6151b373bb2f9065b19934" }],
            "command": ["./mvnw", "-q", "-o", "-Dtest=PetUpdateAcceptanceTests", "test"],
            "reports": ["target/surefire-reports/TEST-org.springframework.samples.petclinic.owner.PetUpdateAcceptanceTests.xml"],
            "cases": [
              { "className": "org.springframework.samples.petclinic.owner.PetUpdateAcceptanceTests", "name": "persistsExistingPetFieldsWithoutAddingDuplicate" },
              { "className": "org.springframework.samples.petclinic.owner.PetUpdateAcceptanceTests", "name": "preservesFallbackForNewUnassociatedPet" },
              { "className": "org.springframework.samples.petclinic.owner.PetUpdateAcceptanceTests", "name": "duplicateNameDoesNotChangeStoredPet" },
              { "className": "org.springframework.samples.petclinic.owner.PetUpdateAcceptanceTests", "name": "futureBirthDateDoesNotChangeStoredPet" }
            ]
          }
        },
        { "id": "spring-07-mysql-user", "decisions": { "modules": ["root"], "databaseImpact": "schema", "schemaStrategy": "bootstrap-only", "apiImpact": "none" } }
      ]
    },
    {
      "id": "nestjs-boilerplate",
      "buildSystem": null,
      "allowedPrefixes": ["src/", "test/", ".hygen/generate/"],
      "setupCommand": ["npm", "ci", "--ignore-scripts"],
      "tasks": [
        { "id": "nest-01-session-update-by-hash", "decisions": { "modules": ["root"], "databaseImpact": "write", "apiImpact": "compatible" } },
        {
          "id": "nest-02-file-relational-mapper",
          "decisions": { "modules": ["root"], "databaseImpact": "read", "apiImpact": "none" },
          "acceptance": {
            "kind": "fixture-tests",
            "files": [
              { "path": "test/bth/file-flow.spec.ts", "fixture": "fixtures/nest/file-flow.spec.ts", "sha256": "30f8531d2500cb29694894ab6d97ca33be35e95de077ef213f119f683c72bfe3" },
              { "path": "test/bth/jest.config.cjs", "fixture": "fixtures/nest/jest.config.cjs", "sha256": "663d94b68f3a7a30e50c7c04404c1456cc8dc65944e2f97d1d1aff0fde9184d8" },
              { "path": "test/bth/run.cjs", "fixture": "fixtures/nest/run.cjs", "sha256": "da9b18110fcbdfba7113c44e41ef328c311f7230c827d5e603df513208db60de" },
              { "path": "test/bth/verify-jest.mjs", "fixture": "fixtures/nest/verify-jest.mjs", "sha256": "c045c9c0adbddceb0dc437ea5f99ee453b3029d101c98b8675be6ed63320da13" }
            ],
            "command": ["node", "test/bth/run.cjs"],
            "reports": ["coverage/bth-junit.xml"],
            "cases": [
              { "className": "test/bth/file-flow.spec.ts", "name": "create returns mapped domain data from the saved entity" },
              { "className": "test/bth/file-flow.spec.ts", "name": "create propagates persistence failure without returning a file" },
              { "className": "test/bth/file-flow.spec.ts", "name": "findById maps existing files and preserves missing-file null" },
              { "className": "test/bth/file-flow.spec.ts", "name": "findByIds maps each returned entity and preserves an empty result" },
              { "className": "test/bth/file-flow.spec.ts", "name": "interceptor emits resolved nested values rather than Promise objects" },
              { "className": "test/bth/file-flow.spec.ts", "name": "interceptor routes rejected values through the observable error channel" },
              { "className": "test/bth/file-flow.spec.ts", "name": "interceptor preserves an upstream observable failure" }
            ]
          }
        },
        { "id": "nest-03-swagger-language-header", "decisions": { "modules": ["root"], "databaseImpact": "none", "apiImpact": "compatible" } },
        { "id": "nest-04-document-find-update", "decisions": { "modules": ["root"], "databaseImpact": "write", "apiImpact": "none" } },
        { "id": "nest-05-auth-email-update", "decisions": { "modules": ["root"], "databaseImpact": "write", "apiImpact": "compatible" } },
        { "id": "nest-06-user-email-conflict", "decisions": { "modules": ["root"], "databaseImpact": "read", "apiImpact": "compatible" } },
        { "id": "nest-07-refresh-token-single-use", "decisions": { "modules": ["root"], "databaseImpact": "schema", "apiImpact": "compatible" } }
      ]
    },
    {
      "id": "fastapi-template",
      "buildSystem": null,
      "allowedPrefixes": ["backend/", "frontend/", "compose.yml", "deployment.md"],
      "setupCommand": ["uv", "sync", "--frozen", "--project", "backend"],
      "tasks": [
        { "id": "fastapi-01-database-url", "decisions": { "modules": ["root"], "databaseImpact": "read", "apiImpact": "none" } },
        { "id": "fastapi-02-cors", "decisions": { "modules": ["root"], "databaseImpact": "none", "apiImpact": "none" } },
        { "id": "fastapi-03-created-at", "decisions": { "modules": ["root"], "databaseImpact": "schema", "apiImpact": "compatible" } },
        { "id": "fastapi-04-constant-time-login", "decisions": { "modules": ["root"], "databaseImpact": "read", "apiImpact": "compatible" } },
        { "id": "fastapi-05-missing-user", "decisions": { "modules": ["root"], "databaseImpact": "read", "apiImpact": "compatible" } },
        { "id": "fastapi-06-delete-self", "decisions": { "modules": ["root"], "databaseImpact": "write", "apiImpact": "compatible" } }
      ]
    }
  ]
}
