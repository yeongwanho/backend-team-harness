        { "id": "spring-06-pet-update", "decisions": { "modules": ["root"], "databaseImpact": "write", "apiImpact": "compatible" } },
        { "id": "spring-07-mysql-user", "decisions": { "modules": ["root"], "databaseImpact": "schema", "apiImpact": "none" } }
      ]
    },
