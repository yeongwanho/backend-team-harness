{
  "name": "backend-team-harness",
  "version": "0.9.0",
  "description": "A source-bound backend verification harness with structured test results and reproducible run records.",
  "type": "module",
  "bin": {
    "bth": "./src/cli.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:coverage": "c8 --all --include=src/**/*.mjs --check-coverage --lines 88 --branches 77 --functions 90 --reporter=text node --test test/*.test.mjs",
    "test:mutation": "node scripts/mutation-smoke.mjs",
    "test:install": "node scripts/install-smoke.mjs",
    "pilot:provider": "node scripts/real-provider-pilot.mjs",
    "test:windows-contract": "node --test test/windows-compat.test.mjs",
    "test:real-jvm": "BTH_REAL_JVM_E2E=1 node --test test/jvm-real-e2e.test.mjs",
    "test:real-db": "BTH_REAL_DB_E2E=1 node --test test/db-real-e2e.test.mjs",
    "benchmark:adaptive": "node scripts/benchmark-adaptive-verification.mjs",
    "check": "node scripts/check-syntax.mjs && node --test test/*.test.mjs && node scripts/mutation-smoke.mjs",
    "example:init": "node src/cli.mjs init examples/spring-service",
    "example:doctor": "node src/cli.mjs doctor examples/spring-service"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "backend",
    "spring-boot",
    "developer-tools",
    "workflow-harness",
    "evidence"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeongwanho/backend-team-harness.git"
  },
  "bugs": {
    "url": "https://github.com/yeongwanho/backend-team-harness/issues"
  },
  "homepage": "https://github.com/yeongwanho/backend-team-harness#readme",
  "license": "MIT",
  "devDependencies": {
    "c8": "^12.0.0"
  }
}
