{
  "name": "backend-team-harness",
  "version": "0.4.0",
  "description": "A source-bound backend verification harness with structured test results and reproducible run records.",
  "type": "module",
  "bin": {
    "bth": "./src/cli.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:real-jvm": "BTH_REAL_JVM_E2E=1 node --test test/jvm-real-e2e.test.mjs",
    "test:real-db": "BTH_REAL_DB_E2E=1 node --test test/db-real-e2e.test.mjs",
    "check": "node scripts/check-syntax.mjs && node --test test/*.test.mjs",
    "example:init": "node src/cli.mjs init examples/spring-service",
    "example:doctor": "node src/cli.mjs doctor examples/spring-service"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "backend",
    "spring-boot",
    "developer-tools",
    "workflow-harness",
    "evidence"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeongwanho/backend-team-harness.git"
  },
  "bugs": {
    "url": "https://github.com/yeongwanho/backend-team-harness/issues"
  },
  "homepage": "https://github.com/yeongwanho/backend-team-harness#readme",
  "license": "MIT"
}
