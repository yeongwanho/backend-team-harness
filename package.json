{
  "name": "backend-team-harness",
  "version": "0.1.0",
  "description": "A provider-neutral AI harness for shared backend engineering workflows.",
  "type": "module",
  "bin": {
    "bth": "./src/cli.mjs"
  },
  "scripts": {
